---
// src/components/HeroSection.astro
import { images } from '../data/images';

// 3枚ずつ自動で切り替わる（スマホは1枚ずつ）。枚数は3の倍数にする
const slides = [
  images.tulipCarvedGoldBox,
  images.redRoseSquare,
  images.blueRoseWoodenBox,
  images.purpleHydrangeaHeart,
  images.pinkFlowerHeartPlate,
  images.lavenderRound,
  images.rainbowFlowerBar,
  images.seahorseBlue,
  images.roseWreathRound,
  images.purpleFlowerTower,
  images.heartTinRainbow,
  images.polkaDotRoseRibbon,
  images.hydrangeaFlowerTiles,
  images.marbleWhiteRose,
  images.heartTopperBox,
  images.moonStarNight,
  images.pinkRibbonHeart,
  images.tulipRound,
];
// 先頭3枚の複製を末尾に置き、最後から先頭へ途切れずにつなぐ
const loopSlides = [...slides, ...slides.slice(0, 3)];
---

<section class="hero" data-carousel>
  <div class="hero__carousel">
    <ul class="hero__track" data-track>
      {loopSlides.map((s, i) => (
        <li class="hero__slide" aria-hidden={i >= slides.length ? 'true' : undefined}>
          <img
            src={s.src}
            alt={i >= slides.length ? '' : s.alt}
            width={s.width}
            height={s.height}
            class="hero__image"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </li>
      ))}
    </ul>
  </div>
  <div class="hero__content">
    <p class="hero__sub">Natural Handmade Soap</p>
    <h1 class="hero__title">自然とともに、<br />肌に優しい石鹸を。</h1>
    <a href="/about" class="hero__cta">ブランドについて</a>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduceMotion) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const realCount = track.children.length - 3;
    const perView = () => (window.matchMedia('(min-width: 768px)').matches ? 3 : 1);
    let index = 0;

    const moveTo = (i: number, animate = true) => {
      track.style.transition = animate ? '' : 'none';
      index = i;
      track.style.transform = `translateX(-${(index * 100) / perView()}%)`;
    };

    // after sliding onto the cloned head, jump back to the real head without animation
    track.addEventListener('transitionend', () => {
      if (index >= realCount) {
        moveTo(index - realCount, false);
        void track.offsetWidth;
      }
    });

    window.setInterval(() => {
      if (document.hidden) return;
      moveTo(index + perView());
    }, 3000);

    window.addEventListener('resize', () => moveTo(0, false));
  }
</script>

<style>
  .hero {
    position: relative;
    height: 80svh;
    min-height: 480px;
    overflow: hidden;
  }
  .hero__carousel {
    position: absolute;
    inset: 0;
  }
  .hero__track {
    display: flex;
    height: 100%;
    list-style: none;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero__slide {
    flex: 0 0 100%;
    height: 100%;
    padding: 0 2px;
  }
  @media (min-width: 768px) {
    .hero__slide { flex-basis: calc(100% / 3); }
  }
  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 2rem;
    background: rgba(250, 249, 247, 0.4);
    pointer-events: none;
  }
  .hero__sub {
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .hero__title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 300;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  .hero__cta {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    background-color: rgba(250, 249, 247, 0.7);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    pointer-events: auto;
    transition: background-color 0.2s, color 0.2s;
  }
  .hero__cta:hover {
    background-color: var(--color-accent);
    color: white;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__track { transition: none; }
  }
</style>
