---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import { getNewsList } from '../lib/microcms';
import type { News } from '../lib/microcms';

let latestNews: News[] = [];
try {
  const { contents } = await getNewsList(3);
  latestNews = contents;
} catch {
  latestNews = [
    { id: 'mock-1', title: '【モック】新商品のお知らせ', body: '', publishedAt: '2026-07-20T00:00:00.000Z' },
    { id: 'mock-2', title: '【モック】夏季休業のご案内', body: '', publishedAt: '2026-07-15T00:00:00.000Z' },
    { id: 'mock-3', title: '【モック】ブランドサイトオープン', body: '', publishedAt: '2026-07-01T00:00:00.000Z' },
  ];
}

// leaf / hand-heart icons from Lucide (https://lucide.dev, ISC license)
const iconLeaf = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`;
const iconHands = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M11 14h2a2 2 0 0 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="m14.45 13.39 5.05-4.694C20.196 8 21 6.85 21 5.75a2.75 2.75 0 0 0-4.797-1.837.276.276 0 0 1-.406 0A2.75 2.75 0 0 0 11 5.75c0 1.2.802 2.248 1.5 2.946L16 11.95"/><path d="m2 15 6 6"/><path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a1 1 0 0 0-2.75-2.91"/></svg>`;
const iconBubbles = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M7.001 15.085A1.5 1.5 0 0 1 9 16.5"/><circle cx="18.5" cy="8.5" r="3.5"/><circle cx="7.5" cy="16.5" r="5.5"/><circle cx="7.5" cy="4.5" r="2.5"/></svg>`;

const features = [
  { icon: iconLeaf, title: '天然素材', description: '化学添加物を使わず、自然由来の素材のみで作られています。' },
  { icon: iconHands, title: '手作り製法', description: 'コールドプロセス製法で一つひとつ丁寧に手作りしています。' },
  { icon: iconBubbles, title: '豊かな泡立ち', description: 'グリセリンが豊富に残り、しっとりとした使い心地を生み出します。' },
];
---

<BaseLayout title="Home" description="自然素材にこだわった手作り石鹸ブランド。">
  <HeroSection />

  <section class="features">
    <div class="container">
      <p class="section-label">Our Philosophy</p>
      <ul class="features__list">
        {features.map((f) => (
          <li class="features__item">
            <span class="features__icon" set:html={f.icon} />
            <h2 class="features__name">{f.title}</h2>
            <p class="features__desc">{f.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-news">
    <div class="container">
      <p class="section-label">Latest News</p>
      <ul class="home-news__list">
        {latestNews.map((news) => (
          <li class="home-news__item">
            <a href={`/news/${news.id}`} class="home-news__link">
              <time class="home-news__date" datetime={news.publishedAt}>
                {new Date(news.publishedAt).toLocaleDateString('ja-JP')}
              </time>
              <span class="home-news__title">{news.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="home-news__more">
        <a href="/news" class="text-link">すべてのお知らせを見る →</a>
      </div>
    </div>
  </section>

  <section class="cta-store">
    <div class="container cta-store__inner">
      <p class="section-label">Online Store</p>
      <p class="cta-store__text">近日公開予定です。お楽しみに。</p>
      <span class="cta-store__badge">Coming Soon</span>
    </div>
  </section>
</BaseLayout>

<style>
  .section-label {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--color-accent);
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 3rem;
  }

  /* Features */
  .features { padding: var(--spacing-section) 0; }
  .features__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    list-style: none;
  }
  @media (min-width: 768px) {
    .features__list { grid-template-columns: repeat(3, 1fr); }
  }
  .features__item { text-align: center; }
  .features__icon { display: flex; justify-content: center; margin-bottom: 1.25rem; color: var(--color-accent); }
  .features__icon :global(svg) { width: 40px; height: 40px; }
  .features__name { font-size: 1rem; font-weight: 500; margin-bottom: 0.75rem; }
  .features__desc { font-size: 0.875rem; color: var(--color-text-light); line-height: 1.8; }

  /* Home News */
  .home-news { padding: var(--spacing-section) 0; background-color: #f5f1ec; }
  .home-news__list { list-style: none; }
  .home-news__item { border-bottom: 1px solid var(--color-border); }
  .home-news__item:first-child { border-top: 1px solid var(--color-border); }
  .home-news__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 0;
    transition: opacity 0.2s;
  }
  .home-news__link:hover { opacity: 0.7; }
  @media (min-width: 768px) {
    .home-news__link { flex-direction: row; gap: 2rem; align-items: center; }
  }
  .home-news__date { font-size: 0.8rem; color: var(--color-text-light); flex-shrink: 0; }
  .home-news__title { font-size: 0.9rem; }
  .home-news__more { text-align: right; margin-top: 1.5rem; }

  /* CTA Store */
  .cta-store { padding: var(--spacing-section) 0; }
  .cta-store__inner {
    text-align: center;
    border: 1px solid var(--color-border);
    padding: 4rem 2rem;
  }
  .cta-store__text { font-size: 0.875rem; color: var(--color-text-light); margin-bottom: 1.5rem; }
  .cta-store__badge {
    display: inline-block;
    padding: 0.4rem 1.25rem;
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--color-text-light);
    text-transform: uppercase;
  }
</style>
